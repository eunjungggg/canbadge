{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canbadge",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* 요청은 정적 파일이 아니라 Worker 코드가 처리
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BOOTH", "class_name": "BoothState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoothState"] }]
}
